# Generated by scripts/generate-redirects.mjs — do not edit by hand.
# Apache config for the static export (Bluehost / cPanel).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^programme/how-it-works/?$ /investor-relations/programme/#how-it-works [R=301,NE,L]
  RewriteRule ^programme/use-of-proceeds/?$ /investor-relations/programme/#use-of-proceeds [R=301,NE,L]
  RewriteRule ^programme/commercial-paper/?$ /investor-relations/programme/#instruments [R=301,NE,L]
  RewriteRule ^programme/bonds/?$ /investor-relations/programme/#instruments [R=301,NE,L]
  RewriteRule ^programme/repayment-structure/?$ /investor-relations/programme/#repayment [R=301,NE,L]
  RewriteRule ^programme/risk-management/?$ /investor-relations/programme/#risk [R=301,NE,L]
  RewriteRule ^market-cocoa/ghana-cocoa-sector/?$ / [R=301,NE,L]
  RewriteRule ^market-cocoa/capital-markets/?$ / [R=301,NE,L]
  RewriteRule ^market-cocoa/insights/?$ /news/ [R=301,NE,L]
  RewriteRule ^investments/how-to-invest/?$ /investor-relations/ [R=301,NE,L]
  RewriteRule ^funding/apply/?$ /about/ [R=301,NE,L]
  RewriteRule ^programme/?$ /investor-relations/programme/ [R=301,NE,L]
  RewriteRule ^market-cocoa/?$ / [R=301,NE,L]
  RewriteRule ^investor-centre/?$ /investor-relations/ [R=301,NE,L]
  RewriteRule ^investments/?$ /investor-relations/ [R=301,NE,L]
  RewriteRule ^funding/?$ /about/ [R=301,NE,L]
  RewriteRule ^industry/?$ / [R=301,NE,L]
  RewriteRule ^careers/?$ / [R=301,NE,L]
  RewriteRule ^esg/?$ / [R=301,NE,L]
</IfModule>

<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/documents/view-only/.*#">
    Header set X-Robots-Tag "noindex, noimageindex"
    Header set Content-Disposition "inline"
    Header set X-Content-Type-Options "nosniff"
  </If>
  # Next.js build assets have content-hashed names, so they never change.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Browser caching (carried over from Bluehost's default configuration).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 24 hours"
  # Pages change on every CMS publish, so browsers revalidate HTML on each visit.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 24 hours"
  ExpiresByType image/png "access plus 24 hours"
  ExpiresByType image/webp "access plus 24 hours"
  ExpiresByType image/svg+xml "access plus 24 hours"
  ExpiresByType text/css "access plus 24 hours"
  ExpiresByType text/javascript "access plus 24 hours"
  ExpiresByType application/javascript "access plus 24 hours"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
