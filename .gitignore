# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Generated view-only page images. Produced by scripts/render-transaction-documents.mjs.
/public/documents/view-only/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Sanity Studio build output
/studio/dist/
/studio/.sanity/

# Transaction PDFs downloaded from Sanity by scripts/sync-sanity.mjs
/.cms-cache/

# Unpublished source PDFs (prospectus, transaction agreements). The repository
# is public, so these must never be committed — CI builds take them from Sanity.
/content/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
