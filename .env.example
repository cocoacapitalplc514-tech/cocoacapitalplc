# Sanity CMS — content is pulled at build time by `npm run cms:sync`.
# Remove SANITY_PROJECT_ID to build from the committed snapshot instead.
# Wrap any value containing # in quotes, e.g. FTP_PASSWORD="abc#123" — unquoted, # starts a comment.
SANITY_PROJECT_ID=1jndvjps
SANITY_DATASET=production
# Only needed if the dataset is private (create a Viewer token in sanity.io/manage → API → Tokens).
SANITY_API_READ_TOKEN=

# Bluehost FTP account for `npm run deploy` (cPanel → Files → FTP Accounts).
FTP_SERVER=sh00987.bluehost.com
FTP_USERNAME=
FTP_PASSWORD=
# Remote folder, relative to the FTP account's home. The Cocoa Capital account opens in the site root.
FTP_SERVER_DIR=./
